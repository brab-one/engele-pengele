# Copy to .env and adjust. `npm start` and `docker compose` read it automatically.

# Docker Compose only: the site's domain (Caddy gets the HTTPS certificate for it).
# With Docker, PORT, HOST, BASE_URL, DATA_DIR and TRUST_PROXY below are set by compose.yaml.
SITE_DOMAIN=wichteln.example.at

# Where the app listens. Keep 127.0.0.1 and put a reverse proxy (Caddy/nginx) with HTTPS in front.
PORT=8787
HOST=127.0.0.1

# Public address, used for links in emails and for secure cookies (https → Secure + HSTS).
BASE_URL=https://wichteln.example.at

# Organiser password for /admin (min. 10 characters).
# If empty, a random one is generated on first start and printed once in the log.
ADMIN_PASSWORD=

# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0

# Where participants are stored (JSON file, readable only by the server user).
DATA_DIR=./data

# Email (optional). Without it, people see their draw only via their personal link.
# SMTP_SECURE: tls (port 465) or starttls (port 587). Certificates are always verified.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pengele Engele <wichteln@example.at>"
