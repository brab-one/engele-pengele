# Für das .env-Feld im Dockge-Stack. Kein "$" im Passwort verwenden (oder als "$$" schreiben).

# Öffentliche Adresse der Seite (so, wie dein Reverse Proxy sie ausliefert)
BASE_URL=https://wichteln.example.at

# Passwort für den Orga-Bereich (/admin), mindestens 10 Zeichen
ADMIN_PASSWORD=

# Port am Server, auf den dein Reverse Proxy weiterleitet
HOST_PORT=8787

# Zeitzone für den Zeitpunkt der Ziehung
TZ=Europe/Vienna
